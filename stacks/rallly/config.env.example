# Configuração da aplicação Rallly
# Copie para config.env e preencha

# URL pública da instância (sem barra no final)
NEXT_PUBLIC_BASE_URL=https://cal.mariomelo.com

# Segredo (mínimo 32 caracteres)
# Gerar com: openssl rand -base64 32
SECRET_PASSWORD=

# Email de suporte exibido para os usuários
SUPPORT_EMAIL=mario@mariomelo.com

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PWD=

# Restrição de acesso (opcional)
# Deixe vazio para permitir qualquer um, ou defina domínios/emails:
# ALLOWED_EMAILS=*@mariomelo.com
ALLOWED_EMAILS=
