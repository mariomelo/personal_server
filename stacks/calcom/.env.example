# Cal.com - Variáveis de Ambiente
# Copie para .env e preencha os valores

# URL pública do Cal.com
NEXT_PUBLIC_WEBAPP_URL=https://cal.mariomelo.com

# Segredos de autenticação
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Chave de criptografia (DEVE ter exatamente 32 caracteres)
# Gerar com: openssl rand -hex 16
CALENDSO_ENCRYPTION_KEY=

# Senha do usuário calcom_user no Postgres compartilhado
# IMPORTANTE: deve ser a mesma usada no setup-db.sh
CALCOM_DB_PASSWORD=

# Email (SMTP)
EMAIL_FROM=noreply@mariomelo.com
EMAIL_FROM_NAME=Cal.com
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
